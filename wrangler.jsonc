{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "trivoxa-group",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"images": {
		// Powers next/image optimization on Workers.
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
	// No R2/KV incremental cache binding: every route is statically prerendered
	// at build time and nothing calls revalidate*, so the static-assets cache
	// (see open-next.config.ts) covers it without extra Cloudflare resources.
}
