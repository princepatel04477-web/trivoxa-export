{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "trivoxa-group",
	"compatibility_date": "2026-08-01",
	// `nodejs_compat` is mandatory for the OpenNext server bundle.
	// `global_fetch_strictly_public` keeps same-origin fetch() going out to the
	// public internet instead of looping back into this Worker — required by the
	// adapter's own template.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Must be explicit. Wrangler disables workers.dev by default the moment a
	// `routes` block exists, so adding custom domains silently took the
	// *.workers.dev URL offline — with the custom domain also failing to
	// attach, that left the Worker unreachable on every hostname at once.
	// Pinning it true keeps this URL as a permanent fallback regardless of what
	// happens to the apex domain's DNS.
	"workers_dev": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"images": {
		// next/image optimization runs through Cloudflare Images on Workers,
		// not sharp. Without this binding images degrade to unoptimized originals.
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
	// No R2/KV incremental cache binding: every route is prerendered at build
	// time and nothing calls revalidate*, so the static-assets cache
	// (see open-next.config.ts) covers it without extra Cloudflare resources.
}
